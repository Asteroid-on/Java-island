    "/audio/decrypt": {
      "post": {
        "summary": "本地解密加密音频，返回音频 base64 或元数据",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "spade_a": {
                    "type": "string"
                  },
                  "hex_key": {
                    "type": "string"
                  },
                  "audio_base64": {
                    "type": "string"
                  },
                  "audio_url": {
                    "type": "string"
                  },
                  "track_id": {
                    "type": "string"
                  },
                  "return_base64": {
                    "type": "boolean",
                    "default": true
                  },
                  "max_bytes": {
                    "type": "integer",
                    "default": 52428800
                  }
                }
              }
            }
          }
