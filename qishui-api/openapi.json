    "/comment": {
      "get": {
        "summary": "获取歌曲评论列表",
        "description": "返回统一响应 { code, message, data, trace_id }；data.comments 为规范化评论列表。group_id、track_id 或 id 至少传一个。",
        "parameters": [
          {
            "name": "group_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "评论 group_id，通常为歌曲 track_id"
          },
          {
            "name": "track_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "歌曲 ID；未传 group_id 时使用"
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "兼容 ID；未传 group_id 和 track_id 时使用"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 50
            }
          },
          {
            "name": "group_type",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "track"
            }
          },
          {
            "name": "image_strategy",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "tplv-luna-shrink:200:200"
            }
          },
          {
            "name": "sort_type",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "hot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success，data 包含 comments、total、cursor、has_more、upstream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "获取歌曲评论列表（POST）",
        "description": "返回统一响应 { code, message, data, trace_id }；group_id、track_id 或 id 至少传一个。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "group_id": {
                    "type": "string"
                  },
                  "track_id": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string",
                    "description": "兼容 ID；未传 group_id 和 track_id 时使用"
                  },
                  "cursor": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "default": 20,
                    "maximum": 50
                  },
                  "group_type": {
                    "type": "string",
                    "default": "track"
                  },
                  "image_strategy": {
                    "type": "string",
                    "default": "tplv-luna-shrink:200:200"
                  },
                  "sort_type": {
                    "type": "string",
                    "default": "hot"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success，data 包含 comments、total、cursor、has_more、upstream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebResponse"
                }
              }
            }
          }
        }
      }
    },
